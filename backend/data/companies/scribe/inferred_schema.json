{
  "tables": [
    {
      "name": "users",
      "columns": [
        {
          "name": "user_id",
          "type": "string",
          "nullable": false,
          "description": "unique identifier for each user"
        },
        {
          "name": "email",
          "type": "string",
          "nullable": false,
          "description": "email address of the user"
        },
        {
          "name": "name",
          "type": "string",
          "nullable": false,
          "description": "full name of the user"
        },
        {
          "name": "role",
          "type": "string",
          "nullable": false,
          "description": "role of the user in the organization"
        },
        {
          "name": "created_at",
          "type": "date",
          "nullable": false,
          "description": "date when the user account was created"
        }
      ],
      "primary_key": "user_id",
      "description": "stores information about users of the platform"
    },
    {
      "name": "subscriptions",
      "columns": [
        {
          "name": "subscription_id",
          "type": "string",
          "nullable": false,
          "description": "unique identifier for each subscription"
        },
        {
          "name": "user_id",
          "type": "string",
          "nullable": false,
          "description": "identifier of the user associated with the subscription"
        },
        {
          "name": "plan",
          "type": "string",
          "nullable": false,
          "description": "type of subscription plan"
        },
        {
          "name": "status",
          "type": "string",
          "nullable": false,
          "description": "current status of the subscription"
        },
        {
          "name": "start_date",
          "type": "date",
          "nullable": false,
          "description": "date when the subscription started"
        },
        {
          "name": "end_date",
          "type": "date",
          "nullable": true,
          "description": "date when the subscription ends"
        }
      ],
      "primary_key": "subscription_id",
      "description": "stores subscription details for users"
    },
    {
      "name": "documents",
      "columns": [
        {
          "name": "document_id",
          "type": "string",
          "nullable": false,
          "description": "unique identifier for each document"
        },
        {
          "name": "user_id",
          "type": "string",
          "nullable": false,
          "description": "identifier of the user who created the document"
        },
        {
          "name": "title",
          "type": "string",
          "nullable": false,
          "description": "title of the document"
        },
        {
          "name": "content",
          "type": "json",
          "nullable": false,
          "description": "content of the document"
        },
        {
          "name": "created_at",
          "type": "date",
          "nullable": false,
          "description": "date when the document was created"
        },
        {
          "name": "updated_at",
          "type": "date",
          "nullable": true,
          "description": "date when the document was last updated"
        }
      ],
      "primary_key": "document_id",
      "description": "stores documents created by users"
    },
    {
      "name": "integrations",
      "columns": [
        {
          "name": "integration_id",
          "type": "string",
          "nullable": false,
          "description": "unique identifier for each integration"
        },
        {
          "name": "name",
          "type": "string",
          "nullable": false,
          "description": "name of the integration"
        },
        {
          "name": "description",
          "type": "string",
          "nullable": true,
          "description": "description of the integration"
        },
        {
          "name": "created_at",
          "type": "date",
          "nullable": false,
          "description": "date when the integration was added"
        }
      ],
      "primary_key": "integration_id",
      "description": "stores information about integrations available on the platform"
    },
    {
      "name": "user_integrations",
      "columns": [
        {
          "name": "user_integration_id",
          "type": "string",
          "nullable": false,
          "description": "unique identifier for each user integration"
        },
        {
          "name": "user_id",
          "type": "string",
          "nullable": false,
          "description": "identifier of the user using the integration"
        },
        {
          "name": "integration_id",
          "type": "string",
          "nullable": false,
          "description": "identifier of the integration being used"
        },
        {
          "name": "enabled",
          "type": "boolean",
          "nullable": false,
          "description": "status of the integration for the user"
        },
        {
          "name": "configured_at",
          "type": "date",
          "nullable": true,
          "description": "date when the integration was configured by the user"
        }
      ],
      "primary_key": "user_integration_id",
      "description": "stores information about which integrations are used by which users"
    }
  ],
  "relationships": [
    {
      "from_table": "subscriptions",
      "from_column": "user_id",
      "to_table": "users",
      "to_column": "user_id",
      "type": "many-to-one"
    },
    {
      "from_table": "documents",
      "from_column": "user_id",
      "to_table": "users",
      "to_column": "user_id",
      "type": "many-to-one"
    },
    {
      "from_table": "user_integrations",
      "from_column": "user_id",
      "to_table": "users",
      "to_column": "user_id",
      "type": "many-to-one"
    },
    {
      "from_table": "user_integrations",
      "from_column": "integration_id",
      "to_table": "integrations",
      "to_column": "integration_id",
      "type": "many-to-one"
    }
  ],
  "description": "This schema is designed for Scribe, a SaaS platform that helps organizations document processes and train employees. It includes tables for users, subscriptions, documents, integrations, and user-specific integration settings, capturing the core functionalities of the platform."
}